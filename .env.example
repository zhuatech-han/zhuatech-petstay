# Fill unique strong passwords. ADMIN_PASSWORD: 12–72 UTF-8 bytes, uppercase/lowercase/digits.
MYSQL_ROOT_PASSWORD=
DATABASE_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
WEB_PORT=8136
BIND_ADDRESS=127.0.0.1
# Enable only behind an HTTPS reverse proxy.
COOKIE_SECURE=false

# Optional external MySQL URL uses jdbc:mysql://; require sslMode=VERIFY_IDENTITY and a trusted CA outside the isolated Compose network.
# DATABASE_URL=
# DATABASE_USER=petstay

# Optional SMTP. Keep disabled until a real SMTP account is configured.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# REQUIRED = STARTTLS required; SSL = implicit TLS; NONE = isolated local test only.
MAIL_TLS=REQUIRED

# Optional compose.storage.yaml: absolute path of a dedicated host database directory.
PETSTAY_MYSQL_DATA_DIR=
